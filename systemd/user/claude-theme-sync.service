[Unit]
Description=Sync Claude Code theme with GNOME color scheme
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/mise/shims/deno run \
  --allow-read --allow-write --allow-run --allow-env \
  %h/.local/bin/claude-theme-sync.ts
Restart=on-failure
RestartSec=5s
Environment=DENO_NO_UPDATE_CHECK=1

[Install]
WantedBy=graphical-session.target
